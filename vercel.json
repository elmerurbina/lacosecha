{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/admin/:path*",
      "has": [{ "type": "host", "value": "(?:www\\.)?comunidadlacosecha\\.com" }],
      "destination": "https://admin.comunidadlacosecha.com/:path*",
      "permanent": true
    },
    {
      "source": "/admin",
      "has": [{ "type": "host", "value": "(?:www\\.)?comunidadlacosecha\\.com" }],
      "destination": "https://admin.comunidadlacosecha.com/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path((?!_astro/|images/|favicon|admin/|admin$).*)",
      "has": [{ "type": "host", "value": "admin.comunidadlacosecha.com" }],
      "destination": "/admin/:path"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "admin.comunidadlacosecha.com" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
