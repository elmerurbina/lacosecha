---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ContactLinks from '../components/ContactLinks.astro';
import PrayerForm from '../components/PrayerForm.astro';
import Icon from '../components/Icon.astro';
import { getSiteInfo } from '../lib/content';

const site = await getSiteInfo();
---
<Layout title="Contacto y oración" description={`Contáctanos por WhatsApp, teléfono o correo, o envíanos tu petición de oración. ${site.name}, Juigalpa.`}>
  <PageHero eyebrow="Contacto" title="Estamos para servirte" lead="Escríbenos, llámanos o visítanos. También puedes enviarnos tu petición de oración." />

  <section class="section">
    <div class="container contact">
      <div>
        <h2 class="h3" data-reveal>Medios de contacto</h2>
        <ContactLinks />
      </div>

      <div class="card prayer-card" id="oracion" data-reveal>
        <span class="prayer-card__icon"><Icon name="hands" size={28} /></span>
        <h2>Petición de oración</h2>
        <p class="muted">“Orad unos por otros” — Santiago 5:16. Nuestro equipo de intercesión orará por tu necesidad.</p>
        <PrayerForm />
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact { display: grid; gap: 48px; align-items: start; }
  @media (min-width: 980px) { .contact { grid-template-columns: 1fr 1.1fr; gap: 56px; } }
  .h3 { font-size: clamp(1.4rem, 2.4vw, 1.8rem); margin-bottom: 20px; }
  .prayer-card { padding: clamp(24px, 4vw, 40px); border-color: var(--line-gold); scroll-margin-top: calc(var(--header-h) + 20px); }
  .prayer-card:hover { transform: none; }
  .prayer-card__icon {
    width: 56px; height: 56px; border-radius: 16px; display: grid; place-items: center;
    background: var(--gold); color: #120d02; margin-bottom: 18px;
  }
  .prayer-card h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); }
</style>
