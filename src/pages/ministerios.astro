---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import MinistryCard from '../components/MinistryCard.astro';
import Icon from '../components/Icon.astro';
import { getCellGroups, getMinistries } from '../lib/content';

const [ministries, cells] = await Promise.all([getMinistries(), getCellGroups()]);
---
<Layout title="Ministerios" description="Conoce los ministerios de la Comunidad Evangélica La Cosecha: jóvenes, discipulado, alabanza, intercesión, Programa Esperanza y más.">
  <PageHero scene="ministries"
    eyebrow="Ministerios"
    title="Hay un lugar para ti"
    lead="Cada ministerio es una forma de crecer en la fe, servir a otros y llevar el amor de Cristo a nuestra comunidad."
  />

  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        {ministries.map((m, i) => <MinistryCard ministry={m} index={i} />)}
      </div>
    </div>
  </section>

  <section class="section section--alt" id="celulas">
    <div class="container cells-teaser" data-reveal>
      <div>
        <p class="eyebrow">Células</p>
        <h2>Grupos de crecimiento</h2>
        <p class="lead">Nos reunimos en {cells.length > 0 ? `${cells.length} hogares` : 'hogares'} de diferentes sectores de Juigalpa para orar, estudiar la Palabra y compartir como familia.</p>
      </div>
      <a href="/celulas" class="btn btn--gold">Conoce las células <Icon name="arrow" /></a>
    </div>
  </section>
</Layout>

<style>
  .cells-teaser { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; }
  .cells-teaser h2 { margin-bottom: 8px; }
  .cells-teaser .lead { margin: 0; }
</style>
