---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SmartImage from '../components/SmartImage.astro';
import Icon from '../components/Icon.astro';
import { getAboutSections, getSiteInfo } from '../lib/content';

const site = await getSiteInfo();
const sections = await getAboutSections();
const leaders = [
  { name: `Pastor ${site.pastor}`, role: 'Pastor general', image: '/images/pastor-pedro.jpg' },
  { name: `Pastora ${site.associatePastor}`, role: 'Pastora asociada', image: '/images/pastora-fatima.jpg' },
];
---
<Layout title="Quiénes somos" description={`Historia, misión, visión, valores y liderazgo de la ${site.name} en Juigalpa, Chontales.`}>
  <PageHero eyebrow="Quiénes somos" title="Una comunidad de fe en Juigalpa" lead={site.description}>
    <nav class="about-nav" aria-label="Secciones de Quiénes somos" data-reveal style="--delay: 240ms">
      {sections.map((s) => <a href={`#${s.id}`}>{s.eyebrow}</a>)}
    </nav>
  </PageHero>

  {sections.map((s, i) => (
    <section class:list={['section about', { 'section--alt': i % 2 === 1 }]} id={s.id} aria-labelledby={`${s.id}-title`}>
      <div class:list={['container about__row', { 'about__row--reverse': i % 2 === 1 }]}>
        <div class="about__media" data-reveal={i % 2 === 0 ? 'left' : 'right'}>
          <SmartImage src={s.image} alt={s.title} label={s.eyebrow} ratio="5 / 4" />
          <span class="about__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        </div>
        <div class="about__text" data-reveal={i % 2 === 0 ? 'right' : 'left'}>
          <p class="eyebrow">{s.eyebrow}</p>
          <h2 id={`${s.id}-title`}>{s.title}</h2>
          <p class="about__subtitle">{s.subtitle}</p>
          <p class="lead">{s.body}</p>
          {s.list && (
            <ul class="values">
              {s.list.map((v) => <li><Icon name="check" size={18} /> {v}</li>)}
            </ul>
          )}
          {s.id === 'liderazgo' && (
            <div class="leaders">
              {leaders.map((p) => (
                <figure class="leader">
                  <SmartImage src={p.image} alt={p.name} label={p.name} ratio="1 / 1" />
                  <figcaption><strong>{p.name}</strong><span>{p.role}</span></figcaption>
                </figure>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  ))}

  <section class="section verse">
    <div class="container" data-reveal>
      <blockquote>
        “{site.motto}”
        <cite>{site.mottoRef}</cite>
      </blockquote>
    </div>
  </section>
</Layout>

<style>
  .about-nav { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; }
  .about-nav a {
    padding: 8px 16px; border-radius: 999px; border: 1px solid var(--line);
    color: var(--text); text-decoration: none; font-size: 0.88rem; font-weight: 600;
    transition: all 0.25s;
  }
  .about-nav a:hover { border-color: var(--gold); color: var(--gold-light); }

  .about__row { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) {
    .about__row { grid-template-columns: 1fr 1fr; gap: 72px; }
    .about__row--reverse .about__media { order: 2; }
  }
  .about__media { position: relative; }
  .about__media :global(.smart-img) { border-radius: var(--radius-lg); border: 1px solid var(--line); box-shadow: var(--shadow); }
  .about__num {
    position: absolute; top: -28px; left: -10px; z-index: 2;
    font-family: var(--font-display); font-size: clamp(3.5rem, 8vw, 6rem); line-height: 1;
    color: transparent; -webkit-text-stroke: 1.5px var(--gold); opacity: 0.85;
  }
  .about__row--reverse .about__num { left: auto; right: -10px; }
  .about__subtitle { color: var(--gold-light); font-weight: 600; margin-top: -4px; }

  .values { list-style: none; padding: 0; margin: 20px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .values li {
    display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 999px;
    background: var(--gold-soft); border: 1px solid var(--line-gold); color: var(--white); font-weight: 600;
  }
  .values :global(svg) { color: var(--gold); }

  .leaders { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-top: 24px; }
  .leader { margin: 0; border-radius: var(--radius); overflow: hidden; background: var(--surface-2); border: 1px solid var(--line); }
  .leader figcaption { padding: 12px 14px; display: flex; flex-direction: column; }
  .leader strong { color: var(--white); font-size: 0.95rem; }
  .leader span { color: var(--gold); font-size: 0.82rem; }

  .verse { text-align: center; background: radial-gradient(ellipse at 50% 100%, rgba(227, 169, 43, 0.2), transparent 60%); }
  .verse blockquote {
    margin: 0 auto; max-width: 28ch;
    font-family: var(--font-display); font-style: italic; font-size: clamp(1.6rem, 3.6vw, 2.6rem);
    color: var(--white); line-height: 1.3;
  }
  .verse cite { display: block; margin-top: 16px; font: 700 0.85rem var(--font-body); letter-spacing: 0.16em; color: var(--gold); font-style: normal; }
</style>
