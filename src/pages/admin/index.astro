---
/**
 * Panel administrativo (RF-22..RF-37).
 * En producción se sirve en https://admin.comunidadlacosecha.com (ver vercel.json).
 * Es una SPA estática: toda la seguridad la imponen Supabase Auth + RLS (RNF-14/16).
 */
import '../../styles/admin.css';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#0a0a0a" />
    <title>Panel administrativo | La Cosecha</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Playfair+Display:wght@600&display=swap" />
  </head>
  <body>
    <div id="app">
      <div class="state" role="status"><span class="spinner" aria-hidden="true"></span>Cargando panel…</div>
    </div>
    <div id="toasts" class="toasts" aria-live="polite"></div>
    <noscript><p class="state">El panel administrativo requiere JavaScript.</p></noscript>
    <script>
      import '../../admin/main';
    </script>
  </body>
</html>
