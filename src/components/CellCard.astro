---
/** Tarjeta de una célula (grupo de crecimiento): foto, título, anfitrión, horario, descripción y ubicación. */
import Icon from './Icon.astro';
import SmartImage from './SmartImage.astro';
import type { CellGroup } from '../lib/types';
import { coordsLink, hasCoords } from '../lib/utils';

interface Props { cell: CellGroup; index?: number }
const { cell: c, index = 0 } = Astro.props;
const title = c.title || `Célula ${c.host}`;
const located = hasCoords(c);
---
<article class="card cell" data-reveal style={`--delay: ${(index % 3) * 90}ms`}>
  <div class="cell__media">
    <SmartImage src={c.image} alt={title} label={title} ratio="4 / 3" />
    {c.meeting && <span class="cell__meeting"><Icon name="clock" size={15} /> {c.meeting}</span>}
  </div>
  <div class="cell__body">
    <span class="cell__icon"><Icon name="users" /></span>
    <h3>{title}</h3>
    <p class="cell__host">Anfitrión: <strong>{c.host}</strong></p>
    <p class="cell__desc">
      {c.description || 'Un espacio en casa para orar, estudiar la Palabra y compartir como familia. ¡Eres bienvenido!'}
    </p>
    {located && (
      <div class="cell__map">
        <iframe
          src={`https://maps.google.com/maps?q=${c.lat},${c.lng}&z=16&output=embed`}
          title={`Mapa: ubicación de ${title}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    )}
    {located && (
      <div class="cell__actions">
        <a href={coordsLink(c.lat!, c.lng!)} target="_blank" rel="noopener" class="btn btn--sm btn--ghost" data-track="maps">
          <Icon name="pin" /> Ver ubicación
        </a>
        <a href={`https://www.google.com/maps/dir/?api=1&destination=${c.lat},${c.lng}`} target="_blank" rel="noopener" class="btn btn--sm btn--gold" data-track="maps">
          <Icon name="navigation" /> Cómo llegar
        </a>
      </div>
    )}
  </div>
</article>

<style>
  .cell { display: flex; flex-direction: column; }
  .cell__media { position: relative; }
  .cell__media :global(.smart-img img) { transition: transform 0.9s var(--ease); }
  .cell:hover .cell__media :global(.smart-img img) { transform: scale(1.06); }
  .cell__meeting {
    position: absolute; left: 14px; top: 14px; z-index: 2;
    display: inline-flex; align-items: center; gap: 6px;
    padding: 6px 12px; border-radius: 999px; font-size: 0.8rem; font-weight: 700;
    background: rgba(10, 10, 10, 0.78); color: var(--gold-light); border: 1px solid var(--line-gold);
  }
  .cell__body { position: relative; padding: 34px 24px 24px; flex: 1; display: flex; flex-direction: column; }
  .cell__icon {
    position: absolute; top: -26px; left: 24px; z-index: 2;
    width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center;
    background: var(--gold); color: #120d02; box-shadow: 0 10px 24px -10px rgba(227, 169, 43, 0.7);
  }
  .cell h3 { margin-bottom: 4px; }
  .cell__host { color: var(--gold); font-size: 0.92rem; margin-bottom: 10px; }
  .cell__host strong { color: var(--gold-light); }
  .cell__desc { color: var(--muted); flex: 1; margin-bottom: 8px; }
  .cell__map {
    position: relative; aspect-ratio: 16 / 10; margin: 6px 0 14px;
    border-radius: var(--radius); overflow: hidden;
    border: 1px solid var(--line-gold); background: var(--surface-3);
  }
  .cell__map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .cell__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .cell__actions :global(.btn) { flex: 1 1 auto; }
</style>
