---
/**
 * Escena animada de fondo para los encabezados.
 * Cada página tiene su propio motivo, sobre una base común de aurora dorada y chispas que suben:
 *  - about: haces de luz que giran desde lo alto
 *  - ministries: órbitas entrelazadas (comunidad que se conecta)
 *  - schedule: esfera de reloj con manecillas y pulsos
 *  - events: cuadrícula de calendario que se ilumina por días
 *  - sermons: onda de voz y ondas concéntricas
 *  - home / default: solo aurora y chispas
 * Todo es CSS/SVG decorativo (aria-hidden) y respeta prefers-reduced-motion.
 */
type Variant = 'about' | 'ministries' | 'schedule' | 'events' | 'sermons' | 'home' | 'default';
interface Props { variant?: Variant; embers?: number }
const { variant = 'default', embers = 22 } = Astro.props;

// Pseudoaleatorio determinista para que el HTML sea estable entre renders.
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const sparks = Array.from({ length: embers }, () => ({
  x: (rnd() * 100).toFixed(1),
  size: (2 + rnd() * 3.5).toFixed(1),
  dur: (9 + rnd() * 10).toFixed(1),
  delay: (-rnd() * 18).toFixed(1),
  drift: Math.round(rnd() * 80 - 40),
}));

const ticks = Array.from({ length: 60 }, (_, i) => i);
const cells = Array.from({ length: 35 }, (_, i) => ({ i, lit: [3, 9, 12, 17, 20, 24, 26, 31].includes(i) }));
const bars = Array.from({ length: 48 }, (_, i) => ({
  i,
  h: (0.25 + Math.abs(Math.sin(i * 0.55)) * 0.55 + rnd() * 0.2).toFixed(2),
  delay: (-(i % 12) * 0.11).toFixed(2),
}));
---
<div class:list={['scene', `scene--${variant}`]} aria-hidden="true">
  <div class="scene__aurora">
    <span class="blob blob--1"></span>
    <span class="blob blob--2"></span>
    <span class="blob blob--3"></span>
  </div>

  {variant === 'about' && (
    <div class="rays">
      <span class="rays__beam"></span>
      <span class="rays__beam rays__beam--b"></span>
      <span class="rays__halo"></span>
    </div>
  )}

  {variant === 'ministries' && (
    <svg class="orbits" viewBox="0 0 400 400">
      <g class="orbits__ring orbits__ring--1">
        <ellipse cx="200" cy="200" rx="170" ry="70" />
        <circle cx="370" cy="200" r="6" />
      </g>
      <g class="orbits__ring orbits__ring--2">
        <ellipse cx="200" cy="200" rx="170" ry="70" transform="rotate(60 200 200)" />
        <circle cx="285" cy="347" r="5" />
      </g>
      <g class="orbits__ring orbits__ring--3">
        <ellipse cx="200" cy="200" rx="170" ry="70" transform="rotate(-60 200 200)" />
        <circle cx="115" cy="347" r="4" />
      </g>
      <circle class="orbits__core" cx="200" cy="200" r="16" />
      <circle class="orbits__pulse" cx="200" cy="200" r="16" />
    </svg>
  )}

  {variant === 'schedule' && (
    <svg class="clock" viewBox="0 0 400 400">
      <circle class="clock__pulse" cx="200" cy="200" r="150" />
      <circle class="clock__pulse clock__pulse--b" cx="200" cy="200" r="150" />
      <circle class="clock__face" cx="200" cy="200" r="170" />
      <g class="clock__ticks">
        {ticks.map((t) => (
          <line x1="200" y1={t % 5 === 0 ? 40 : 46} x2="200" y2="56" transform={`rotate(${t * 6} 200 200)`} class:list={{ major: t % 5 === 0 }} />
        ))}
      </g>
      <line class="clock__hand clock__hand--h" x1="200" y1="200" x2="200" y2="120" />
      <line class="clock__hand clock__hand--m" x1="200" y1="200" x2="200" y2="72" />
      <circle class="clock__pin" cx="200" cy="200" r="7" />
    </svg>
  )}

  {variant === 'events' && (
    <div class="cal">
      {cells.map((c) => (
        <span class:list={['cal__cell', { 'is-lit': c.lit }]} style={`--i: ${c.i}`}></span>
      ))}
    </div>
  )}

  {variant === 'sermons' && (
    <>
      <div class="ripples">
        <span></span><span></span><span></span><span></span>
      </div>
      <div class="wave">
        {bars.map((b) => <span style={`--h: ${b.h}; --d: ${b.delay}s`}></span>)}
      </div>
    </>
  )}

  <div class="scene__sparks">
    {sparks.map((s) => (
      <span style={`--x: ${s.x}%; --s: ${s.size}px; --dur: ${s.dur}s; --delay: ${s.delay}s; --drift: ${s.drift}px`}></span>
    ))}
  </div>
  <div class="scene__grain"></div>
</div>

<style>
  .scene { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }

  /* ---------- Aurora base ---------- */
  /* Sin filter: blur ni mix-blend-mode: los degradados radiales ya son suaves y así
     el navegador solo mueve capas (transform), sin repintar en cada cuadro. */
  .scene__aurora { position: absolute; inset: -20%; opacity: 0.75; }
  .blob { position: absolute; border-radius: 50%; will-change: transform; }
  .blob--1 {
    width: 46%; height: 60%; right: 6%; top: 0;
    background: radial-gradient(circle, rgba(227, 169, 43, 0.3) 0%, rgba(227, 169, 43, 0.12) 35%, transparent 70%);
    animation: drift-a 26s ease-in-out infinite alternate;
  }
  .blob--2 {
    width: 38%; height: 50%; left: 8%; bottom: 0;
    background: radial-gradient(circle, rgba(184, 129, 26, 0.24) 0%, rgba(184, 129, 26, 0.09) 35%, transparent 70%);
    animation: drift-b 32s ease-in-out infinite alternate;
  }
  .blob--3 {
    width: 30%; height: 40%; left: 45%; top: 30%;
    background: radial-gradient(circle, rgba(244, 201, 93, 0.14) 0%, rgba(244, 201, 93, 0.05) 35%, transparent 70%);
    animation: drift-c 22s ease-in-out infinite alternate;
  }
  @keyframes drift-a { to { transform: translate3d(-18%, 22%, 0) scale(1.15); } }
  @keyframes drift-b { to { transform: translate3d(24%, -18%, 0) scale(1.2); } }
  @keyframes drift-c { to { transform: translate3d(-30%, -20%, 0) scale(0.85); } }

  /* ---------- Chispas que suben ---------- */
  .scene__sparks span {
    position: absolute; left: var(--x); bottom: -12px;
    width: var(--s); height: var(--s); border-radius: 50%;
    background: var(--gold-light);
    box-shadow: 0 0 10px 2px rgba(244, 201, 93, 0.55);
    opacity: 0; will-change: transform, opacity;
    animation: ember var(--dur) linear infinite;
    animation-delay: var(--delay);
  }
  @keyframes ember {
    0% { transform: translate3d(0, 0, 0) scale(1); opacity: 0; }
    10% { opacity: 0.9; }
    70% { opacity: 0.55; }
    100% { transform: translate3d(var(--drift), -110vh, 0) scale(0.3); opacity: 0; }
  }

  .scene__grain {
    position: absolute; inset: 0; opacity: 0.05; mix-blend-mode: overlay;
    background-image: radial-gradient(rgba(255, 255, 255, 0.8) 1px, transparent 1px);
    background-size: 3px 3px;
  }

  /* Los motivos se colocan a la derecha para no competir con el texto. */
  .rays, .orbits, .clock, .cal, .wave, .ripples { position: absolute; }

  /* ---------- Quiénes somos: haces de luz ---------- */
  .rays { right: -10%; top: -40%; width: min(900px, 90vw); aspect-ratio: 1; }
  .rays__beam {
    position: absolute; inset: 0; border-radius: 50%;
    background: repeating-conic-gradient(from 0deg,
      rgba(244, 201, 93, 0.16) 0deg 4deg, transparent 4deg 18deg);
    mask-image: radial-gradient(circle, #000 0%, transparent 68%);
    -webkit-mask-image: radial-gradient(circle, #000 0%, transparent 68%);
    animation: spin 90s linear infinite;
  }
  .rays__beam--b {
    background: repeating-conic-gradient(from 9deg,
      rgba(227, 169, 43, 0.1) 0deg 2deg, transparent 2deg 24deg);
    animation-duration: 140s; animation-direction: reverse;
  }
  .rays__halo {
    position: absolute; inset: 38%; border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 233, 170, 0.55), rgba(227, 169, 43, 0.15) 45%, transparent 70%);
    animation: breathe 6s ease-in-out infinite;
  }

  /* ---------- Ministerios: órbitas ---------- */
  .orbits { right: -4%; top: 50%; width: min(560px, 70vw); translate: 0 -50%; overflow: visible; }
  .orbits ellipse { fill: none; stroke: rgba(227, 169, 43, 0.32); stroke-width: 1.2; }
  .orbits circle { fill: var(--gold-light); filter: drop-shadow(0 0 6px rgba(244, 201, 93, 0.9)); }
  .orbits__ring { transform-origin: 200px 200px; animation: spin 26s linear infinite; }
  .orbits__ring--2 { animation-duration: 34s; animation-direction: reverse; }
  .orbits__ring--3 { animation-duration: 42s; }
  .orbits__core { fill: var(--gold) !important; }
  .orbits__pulse {
    fill: none !important; stroke: var(--gold); stroke-width: 1.5; filter: none !important;
    transform-origin: 200px 200px; animation: ping 3.2s var(--ease) infinite;
  }

  /* ---------- Horarios: reloj ---------- */
  .clock { right: -2%; top: 50%; width: min(460px, 62vw); translate: 0 -50%; overflow: visible; }
  .clock__face { fill: rgba(227, 169, 43, 0.04); stroke: rgba(227, 169, 43, 0.3); stroke-width: 1.2; }
  .clock__ticks line { stroke: rgba(227, 169, 43, 0.35); stroke-width: 1.5; stroke-linecap: round; }
  .clock__ticks line.major { stroke: var(--gold); stroke-width: 3; }
  .clock__ticks { transform-origin: 200px 200px; animation: spin 240s linear infinite reverse; }
  .clock__hand { stroke: var(--gold-light); stroke-linecap: round; transform-origin: 200px 200px; }
  .clock__hand--h { stroke-width: 6; animation: spin 72s linear infinite; }
  .clock__hand--m { stroke-width: 3.5; animation: spin 9s linear infinite; }
  .clock__pin { fill: var(--gold); }
  .clock__pulse { fill: none; stroke: var(--gold); stroke-width: 1.2; transform-origin: 200px 200px; animation: ping-soft 4s ease-out infinite; }
  .clock__pulse--b { animation-delay: 2s; }

  /* ---------- Eventos: calendario que se ilumina ---------- */
  .cal {
    right: 4%; top: 50%; translate: 0 -50%;
    display: grid; grid-template-columns: repeat(7, 1fr); gap: clamp(6px, 1vw, 12px);
    width: min(440px, 58vw); transform: perspective(900px) rotateY(-22deg) rotateX(10deg);
  }
  .cal__cell {
    aspect-ratio: 1; border-radius: 8px;
    border: 1px solid rgba(227, 169, 43, 0.18); background: rgba(227, 169, 43, 0.03);
    animation: cell-glow 7s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.2s);
  }
  .cal__cell.is-lit { animation-name: cell-lit; border-color: rgba(227, 169, 43, 0.45); }
  @keyframes cell-glow {
    0%, 80%, 100% { background: rgba(227, 169, 43, 0.03); }
    88% { background: rgba(227, 169, 43, 0.16); }
  }
  @keyframes cell-lit {
    0%, 100% { background: rgba(227, 169, 43, 0.12); box-shadow: none; }
    50% { background: rgba(227, 169, 43, 0.5); box-shadow: 0 0 22px rgba(244, 201, 93, 0.55); }
  }

  /* ---------- Prédicas: onda de voz ---------- */
  .wave {
    left: 48%; right: -4%; bottom: 18%; height: 120px;
    display: flex; align-items: center; justify-content: center; gap: clamp(3px, 0.6vw, 8px);
    mask-image: linear-gradient(90deg, transparent, #000 25%, #000 75%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 25%, #000 75%, transparent);
    opacity: 0.55;
  }
  .wave span {
    width: clamp(3px, 0.5vw, 5px); height: calc(var(--h) * 100%); border-radius: 4px;
    background: linear-gradient(var(--gold-light), var(--gold-dark));
    transform-origin: center; animation: voice 1.3s ease-in-out infinite; animation-delay: var(--d);
  }
  @keyframes voice { 0%, 100% { transform: scaleY(0.35); } 50% { transform: scaleY(1); } }
  .ripples { right: 6%; top: 38%; width: min(320px, 44vw); aspect-ratio: 1; translate: 0 -50%; }
  .ripples span {
    position: absolute; inset: 0; border-radius: 50%; border: 1.5px solid rgba(227, 169, 43, 0.5);
    animation: ping-soft 6s ease-out infinite;
  }
  .ripples span:nth-child(2) { animation-delay: 1.5s; }
  .ripples span:nth-child(3) { animation-delay: 3s; }
  .ripples span:nth-child(4) { animation-delay: 4.5s; }

  /* ---------- Compartidas ---------- */
  @keyframes spin { to { rotate: 360deg; } }
  @keyframes breathe { 0%, 100% { transform: scale(0.9); opacity: 0.7; } 50% { transform: scale(1.12); opacity: 1; } }
  @keyframes ping { 0% { transform: scale(1); opacity: 0.9; } 100% { transform: scale(5); opacity: 0; } }
  @keyframes ping-soft { 0% { transform: scale(0.3); opacity: 0.8; } 100% { transform: scale(1.25); opacity: 0; } }

  @media (max-width: 720px) {
    .orbits, .clock, .cal, .ripples { opacity: 0.45; right: -24%; }
    .wave { left: 0; right: 0; bottom: 4%; height: 70px; opacity: 0.3; }
    .scene__sparks span:nth-child(n + 14) { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene *, .scene *::before, .scene *::after { animation: none !important; }
    .scene__sparks { display: none; }
  }
</style>
