---
import Icon from './Icon.astro';
import SmartImage from './SmartImage.astro';
import type { Ministry } from '../lib/types';

interface Props { ministry: Ministry; index?: number }
const { ministry: m, index = 0 } = Astro.props;
const panelId = `ministry-${m.id}`;

// Galería: fotos y videos en el orden del panel; si el registro es anterior, su única imagen.
const media = (m.media?.length ? m.media : m.image ? [{ url: m.image, type: 'image' as const }] : []);
const coverItem = media.find((x) => x.url === m.cover) ?? media[0] ?? null;
const photos = media.filter((x) => x.type === 'image').length;
const videos = media.length - photos;
const coverIndex = coverItem ? media.indexOf(coverItem) : 0;
---
<article class="card ministry" data-reveal style={`--delay: ${(index % 3) * 90}ms`} data-expandable
  data-media={JSON.stringify(media)} data-title={m.name}>
  <div class="ministry__cover">
    {coverItem?.type === 'video' ? (
      <div class="ministry__video">
        <video src={coverItem.url} muted loop playsinline autoplay preload="metadata" aria-label={`Video de ${m.name}`} data-cover-video></video>
      </div>
    ) : (
      <SmartImage src={coverItem?.url ?? null} alt={m.name} ratio="16 / 10" />
    )}
    {media.length > 1 && (
      <button type="button" class="ministry__count" data-open={coverIndex} aria-label={`Ver galería de ${m.name}: ${photos} fotos y ${videos} videos`}>
        {photos > 0 && <span><Icon name="camera" size={15} /> {photos}</span>}
        {videos > 0 && <span><Icon name="video" size={15} /> {videos}</span>}
        <Icon name="expand" size={14} />
      </button>
    )}
  </div>
  <div class="ministry__body">
    <span class="ministry__icon"><Icon name={m.icon} /></span>
    <h3>{m.name}</h3>
    <p class="ministry__summary">{m.summary}</p>

    <div class="ministry__panel" id={panelId} data-panel>
      <div class="ministry__panel-inner">
        <p>{m.description}</p>
        {m.activities.length > 0 && (
          <>
            <h4>Actividades</h4>
            <ul>{m.activities.map((a) => <li>{a}</li>)}</ul>
          </>
        )}
        {media.length > 1 && (
          <>
            <h4>Galería</h4>
            <ul class="ministry__thumbs">
              {media.map((x, i) => (
                <li>
                  <button type="button" data-open={i} aria-label={`Abrir ${x.type === 'video' ? 'video' : 'foto'} ${i + 1} de ${media.length}`}>
                    {x.type === 'video'
                      ? <video src={`${x.url}#t=0.5`} muted playsinline preload="metadata" tabindex="-1"></video>
                      : <img src={x.url} alt="" loading="lazy" decoding="async" onerror="this.closest('li').remove()" />}
                    {x.type === 'video' && <span class="ministry__play"><Icon name="play" size={14} /></span>}
                  </button>
                </li>
              ))}
            </ul>
          </>
        )}
        {m.leaders.length > 0 && (
          <>
            <h4>{m.leaders.length > 1 ? 'Líderes' : 'Líder'}</h4>
            <p class="ministry__leaders"><Icon name="users" size={18} /> {m.leaders.join(', ')}</p>
          </>
        )}
      </div>
    </div>

    <button type="button" class="ministry__toggle" aria-expanded="false" aria-controls={panelId} data-toggle>
      <span data-label>Ver más</span>
      <Icon name="chevron-down" size={18} />
    </button>
  </div>
</article>

<style>
  .ministry { display: flex; flex-direction: column; }
  .ministry__cover { position: relative; }
  .ministry__video { aspect-ratio: 16 / 10; background: var(--surface-3); overflow: hidden; }
  .ministry__video video { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.9s var(--ease); }
  .ministry:hover .ministry__video video { transform: scale(1.04); }
  .ministry__count {
    position: absolute; right: 12px; top: 12px; z-index: 3;
    display: inline-flex; align-items: center; gap: 10px; padding: 7px 12px; border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18); background: rgba(10, 10, 10, 0.72); color: var(--white);
    font: 700 0.8rem var(--font-body); cursor: pointer; backdrop-filter: blur(6px);
    transition: background-color 0.12s, border-color 0.12s, transform 0.12s ease-out;
  }
  .ministry__count span { display: inline-flex; align-items: center; gap: 5px; }
  .ministry__count :global(svg) { color: var(--gold-light); }
  .ministry__count:hover { background: rgba(227, 169, 43, 0.9); border-color: var(--gold); color: #120d02; transform: translateY(-1px); }
  .ministry__count:hover :global(svg) { color: #120d02; }
  .ministry__thumbs { list-style: none; padding: 0 !important; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
  .ministry__thumbs button {
    position: relative; display: block; width: 100%; aspect-ratio: 1; padding: 0; border: 0; cursor: pointer;
    border-radius: 8px; overflow: hidden; background: var(--surface-3);
    outline-offset: 2px; transition: transform 0.12s ease-out;
  }
  .ministry__thumbs button:hover { transform: scale(1.04); }
  .ministry__thumbs img, .ministry__thumbs video { width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; }
  .ministry__play {
    position: absolute; inset: 0; margin: auto; width: 28px; height: 28px; border-radius: 50%;
    display: grid; place-items: center; background: rgba(10, 10, 10, 0.7); color: var(--gold-light);
  }
  .ministry__body { position: relative; padding: 32px 24px 22px; flex: 1; display: flex; flex-direction: column; }
  .ministry__icon {
    position: absolute; top: -26px; left: 24px;
    width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center;
    background: var(--gold); color: #120d02; box-shadow: 0 10px 24px -10px rgba(227, 169, 43, 0.7);
    z-index: 2;
  }
  .ministry h3 { margin-bottom: 6px; }
  .ministry__summary { color: var(--muted); margin-bottom: 8px; }
  .ministry__panel {
    display: grid; grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s var(--ease);
  }
  .ministry__panel-inner { overflow: hidden; visibility: hidden; transition: visibility 0s 0.45s; }
  .ministry.is-open .ministry__panel { grid-template-rows: 1fr; }
  .ministry.is-open .ministry__panel-inner { visibility: visible; transition-delay: 0s; }
  html:not(.js) .ministry__panel { grid-template-rows: 1fr; }
  html:not(.js) .ministry__panel-inner { visibility: visible; }
  html:not(.js) .ministry__toggle { display: none; }
  .ministry__panel-inner > :first-child { margin-top: 8px; }
  .ministry h4 {
    font-family: var(--font-body); font-size: 0.75rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--gold); margin: 16px 0 6px;
  }
  .ministry ul { margin: 0; padding-left: 18px; color: var(--text); }
  .ministry ul li::marker { color: var(--gold); }
  .ministry__leaders { display: flex; gap: 8px; align-items: flex-start; margin: 0; }
  .ministry__leaders :global(svg) { color: var(--gold); flex: none; margin-top: 4px; }
  .ministry__toggle {
    margin-top: auto; align-self: flex-start;
    display: inline-flex; align-items: center; gap: 6px;
    padding: 10px 0 2px; min-height: 44px; background: none; border: 0; cursor: pointer;
    color: var(--gold-light); font: 700 0.92rem var(--font-body);
  }
  .ministry__toggle :global(svg) { transition: transform 0.35s var(--ease); }
  .ministry.is-open .ministry__toggle :global(svg) { transform: rotate(180deg); }
  .ministry__toggle:hover { color: var(--gold); }
</style>

<script>
  import { openLightbox, type LightboxItem } from '../lib/lightbox';

  document.addEventListener('astro:page-load', () => {
    // Galería: el contador de la portada y las miniaturas abren el visor.
    document.querySelectorAll<HTMLElement>('.ministry[data-media]').forEach((card) => {
      if (card.dataset.lbx) return;
      card.dataset.lbx = '1';
      let list: LightboxItem[] = [];
      try { list = JSON.parse(card.dataset.media || '[]'); } catch { list = []; }
      card.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) =>
        b.addEventListener('click', () => openLightbox(list, Number(b.dataset.open), card.dataset.title ?? '')));
    });

    // Videos de portada: solo se reproducen cuando están en pantalla y si no se pidió reducir el movimiento.
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const vids = document.querySelectorAll<HTMLVideoElement>('[data-cover-video]');
    if (reduce) vids.forEach((v) => { v.pause(); v.removeAttribute('autoplay'); v.controls = true; });
    else if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => entries.forEach((e) => {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) v.play().catch(() => {}); else v.pause();
      }), { threshold: 0.25 });
      vids.forEach((v) => io.observe(v));
    }

    document.querySelectorAll<HTMLElement>('[data-expandable]').forEach((card) => {
      const btn = card.querySelector<HTMLButtonElement>('[data-toggle]');
      const label = card.querySelector('[data-label]');
      if (!btn || btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => {
        const open = !card.classList.contains('is-open');
        card.classList.toggle('is-open', open);
        btn.setAttribute('aria-expanded', String(open));
        if (label) label.textContent = open ? 'Ver menos' : 'Ver más';
      });
    });
  });
</script>
