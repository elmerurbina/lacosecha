---
import Icon from './Icon.astro';
import SmartImage from './SmartImage.astro';
import type { Announcement } from '../lib/types';
import { formatDate } from '../lib/utils';

interface Props { items: Announcement[]; limit?: number }
const { items, limit } = Astro.props;
const list = [...items]
  .sort((a, b) => Number(!!b.featured) - Number(!!a.featured) || b.date.localeCompare(a.date))
  .slice(0, limit);
---
{list.length === 0 ? (
  <p class="empty">No hay anuncios publicados por el momento.</p>
) : (
  <div class="ann-list">
    {list.map((a, i) => (
      <article class:list={['card ann', { 'ann--featured': a.featured }]} data-reveal style={`--delay: ${i * 80}ms`}>
        {a.image && <SmartImage src={a.image} alt={a.title} ratio="16 / 9" />}
        <div class="ann__body">
          <div class="ann__meta">
            <Icon name="megaphone" size={16} />
            <time datetime={a.date}>{formatDate(a.date)}</time>
            {a.featured && <span class="ann__tag">Destacado</span>}
          </div>
          <h3>{a.title}</h3>
          <p>{a.body}</p>
        </div>
      </article>
    ))}
  </div>
)}

<style>
  .ann-list { display: grid; gap: 20px; }
  @media (min-width: 760px) { .ann-list { grid-template-columns: repeat(2, 1fr); } }
  .ann__body { padding: 24px; }
  .ann--featured { border-color: var(--line-gold); background: linear-gradient(150deg, rgba(227, 169, 43, 0.1), var(--surface-2) 55%); }
  .ann__meta { display: flex; align-items: center; gap: 8px; color: var(--gold); font-size: 0.82rem; font-weight: 700; margin-bottom: 10px; flex-wrap: wrap; }
  .ann__tag { background: var(--gold); color: #120d02; padding: 2px 10px; border-radius: 999px; font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .ann h3 { margin-bottom: 8px; }
  .ann p { margin: 0; color: var(--muted); }
</style>
