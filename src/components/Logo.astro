---
/**
 * Logotipo de la iglesia (se configura en el panel; por defecto /logo.png).
 * Si el archivo no carga, se oculta el emblema y queda solo el nombre.
 */
interface Props { size?: number; withText?: boolean; src?: string | null }
const { size = 48, withText = true, src = '/logo.png' } = Astro.props;
---
<span class="logo" style={`--size: ${size}px`}>
  {src && (
    <span class="logo__mark">
      <img src={src} alt="" width={size} height={size} decoding="async" onerror="this.parentElement.remove()" />
    </span>
  )}
  {withText && (
    <span class="logo__text">
      <span class="logo__small">Comunidad Evangélica</span>
      <span class="logo__name">La Cosecha</span>
    </span>
  )}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 12px; }
  .logo__mark { position: relative; width: var(--size); height: var(--size); flex: none; }
  .logo__mark img { width: 100%; height: 100%; object-fit: contain; }
  .logo__text { display: flex; flex-direction: column; line-height: 1.05; }
  .logo__small {
    font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--muted); font-weight: 600;
  }
  .logo__name {
    font-family: var(--font-display); font-size: 1.35rem; color: var(--white); font-weight: 600;
  }
</style>
