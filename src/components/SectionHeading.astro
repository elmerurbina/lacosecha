---
interface Props { eyebrow: string; title: string; lead?: string; center?: boolean; id?: string }
const { eyebrow, title, lead, center = false, id } = Astro.props;
---
<header class:list={['sh', { 'sh--center': center }]}>
  <p class="eyebrow" data-reveal>{eyebrow}</p>
  <h2 id={id} data-reveal style="--delay: 60ms">{title}</h2>
  {lead && <p class="lead" data-reveal style="--delay: 120ms">{lead}</p>}
  <slot />
</header>

<style>
  .sh { margin-bottom: clamp(32px, 5vw, 52px); max-width: 720px; }
  .sh--center { margin-inline: auto; text-align: center; }
  .sh--center .eyebrow { justify-content: center; }
  .sh--center .lead { margin-inline: auto; }
</style>
