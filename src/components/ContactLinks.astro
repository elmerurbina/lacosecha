---
import Icon from './Icon.astro';
import { links } from '../lib/utils';
import type { SiteInfo } from '../lib/types';

interface Props { site: SiteInfo }
const { site: siteInfo } = Astro.props;
const handle = (url: string, fallback: string) => {
  const m = url.match(/(?:instagram|tiktok)\.com\/@?([\w.]+)/i);
  return m ? `@${m[1]}` : fallback;
};

const l = links(siteInfo);
const items = [
  { icon: 'whatsapp', label: 'WhatsApp', value: siteInfo.phone, href: l.whatsapp, external: true, track: 'whatsapp', cta: 'Abrir chat' },
  { icon: 'phone', label: 'Teléfono', value: siteInfo.phone, href: l.phone, track: 'phone', cta: 'Llamar' },
  { icon: 'mail', label: 'Correo', value: siteInfo.email, href: l.email, track: 'email', cta: 'Escribir' },
  { icon: 'pin', label: 'Ubicación', value: siteInfo.address, href: l.maps, external: true, track: 'maps', cta: 'Cómo llegar' },
  { icon: 'facebook', label: 'Facebook', value: siteInfo.name, href: siteInfo.social.facebook, external: true, track: 'facebook', cta: 'Visitar' },
  { icon: 'instagram', label: 'Instagram', value: handle(siteInfo.social.instagram, 'Instagram'), href: siteInfo.social.instagram, external: true, track: 'instagram', cta: 'Seguir' },
  { icon: 'tiktok', label: 'TikTok', value: handle(siteInfo.social.tiktok, 'TikTok'), href: siteInfo.social.tiktok, external: true, track: 'tiktok', cta: 'Seguir' },
];
---
<ul class="contact-links">
  {items.map((it, i) => (
    <li data-reveal style={`--delay: ${(i % 4) * 60}ms`}>
      <a
        href={it.href}
        target={it.external ? '_blank' : undefined}
        rel={it.external ? 'noopener' : undefined}
        data-track={it.track}
      >
        <span class="contact-links__icon"><Icon name={it.icon} /></span>
        <span class="contact-links__text">
          <span class="contact-links__label">{it.label}</span>
          <span class="contact-links__value">{it.value}</span>
        </span>
        <span class="contact-links__cta">{it.cta} <Icon name="arrow" size={16} /></span>
      </a>
    </li>
  ))}
</ul>

<style>
  .contact-links { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .contact-links a {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16px;
    padding: 16px 18px; border-radius: var(--radius);
    background: var(--surface-2); border: 1px solid var(--line);
    color: var(--text); text-decoration: none;
    transition: border-color 0.25s, transform 0.3s var(--ease), background 0.25s;
  }
  .contact-links a:hover { border-color: var(--gold); transform: translateX(4px); color: var(--text); }
  .contact-links__icon {
    width: 46px; height: 46px; border-radius: 12px; display: grid; place-items: center;
    background: var(--gold-soft); color: var(--gold);
  }
  .contact-links__text { min-width: 0; display: flex; flex-direction: column; }
  .contact-links__label { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); font-weight: 700; }
  .contact-links__value { color: var(--white); font-weight: 600; overflow-wrap: anywhere; line-height: 1.4; }
  .contact-links__cta {
    display: inline-flex; align-items: center; gap: 6px; color: var(--gold-light);
    font-size: 0.85rem; font-weight: 700; white-space: nowrap;
  }
  @media (max-width: 520px) {
    .contact-links a { grid-template-columns: auto 1fr; }
    .contact-links__cta { display: none; }
  }
</style>
