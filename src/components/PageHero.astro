---
/** Encabezado para páginas interiores. */
import Wheat from './Wheat.astro';
interface Props { eyebrow: string; title: string; lead?: string }
const { eyebrow, title, lead } = Astro.props;
---
<section class="page-hero">
  <Wheat class="page-hero__wheat" />
  <div class="container">
    <p class="eyebrow" data-reveal>{eyebrow}</p>
    <h1 data-reveal style="--delay: 80ms">{title}</h1>
    {lead && <p class="lead" data-reveal style="--delay: 160ms">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative; overflow: hidden;
    padding: calc(var(--header-h) + clamp(56px, 9vw, 110px)) 0 clamp(48px, 7vw, 80px);
    background:
      radial-gradient(ellipse at 85% 0%, rgba(227, 169, 43, 0.18), transparent 55%),
      linear-gradient(180deg, #14120e 0%, var(--black) 100%);
    border-bottom: 1px solid var(--line);
  }
  .page-hero h1 { max-width: 18ch; }
  .page-hero :global(.page-hero__wheat) {
    position: absolute; right: -40px; bottom: -60px;
    width: clamp(220px, 34vw, 420px); height: auto;
    color: var(--gold); opacity: 0.07; transform: rotate(18deg);
    pointer-events: none;
  }
</style>
